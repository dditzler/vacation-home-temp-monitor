#pragma once

// ============================================================
//  secrets.h.example — Copy this to secrets.h and fill in
//  your values.  secrets.h is gitignored; this file is not.
// ============================================================

// ─── WiFi networks (tried in order) ──────────────────────────
#define WIFI_SSID_1  "WookieBear"
#define WIFI_PASS_1  "YourHomePassword"

#define WIFI_SSID_2  "YourVacationHomeSSID"
#define WIFI_PASS_2  "YourVacationHomePassword"

// ─── MQTT broker credentials (HiveMQ Cloud) ──────────────────
#define MQTT_USER_VAL  "your-mqtt-username"
#define MQTT_PASS_VAL  "your-mqtt-password"

// ─── GitHub OTA PAT ──────────────────────────────────────────
// Fine-grained PAT scoped to the vacation-home-temp-monitor repo.
// Required permission: Contents → Read-only
// Generate at: https://github.com/settings/personal-access-tokens
#define OTA_GITHUB_TOKEN  "github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

// ─── Hologram API (used by hologram_monitor.py, not the ESP32) ───
// API key: dashboard.hologram.io → Account Settings → API
// Device ID + Link ID: visible in the dashboard or GET /api/1/devices
// These are for reference only — the ESP32 firmware does not use them.
// Add them to hologram_monitor.env instead.
//
// HOLOGRAM_API_KEY   = "your-hologram-api-key"
// HOLOGRAM_DEVICE_ID = "123456"
// HOLOGRAM_LINK_ID   = "654321"
//
// The hub does need its phone number for SMS receive (set in firmware):
#define HOLOGRAM_HUB_PHONE  "+1XXXXXXXXXX"   // hub's Hologram-assigned phone number
